{
  "version": "1.0.0",
  "name": "Contact Form Example",
  "description": "Example demonstrating contact form submission with faker-generated data and global variables",
  "tests": [
    {
      "id": "test-contact-form-submission",
      "name": "Submit contact form with faker data",
      "description": "Fill and submit contact form using dynamically generated faker data",
      "tags": [
        "web",
        "contact",
        "form",
        "faker"
      ],
      "steps": [
        {
          "id": "w/3bNFUPKCll|$4GeJ7.",
          "type": "web_navigate",
          "params": {
            "URL": "${baseUrl}",
            "WAIT_UNTIL": "load"
          }
        },
        {
          "id": "(9C|oX3G!]f~4C8cB@`1",
          "type": "web_click",
          "params": {
            "SELECTOR": "[data-test=\"nav-contact\"]"
          }
        },
        {
          "id": "|eyVaHn.1Y+xX38!Pv7G",
          "type": "faker_store_value",
          "params": {
            "VARIABLE": "firstName",
            "TYPE": "firstName"
          }
        },
        {
          "id": ",fl)nIO?l1er)#|xutg:",
          "type": "web_fill",
          "params": {
            "SELECTOR": "[data-test=\"first-name\"]",
            "VALUE": "${firstName}"
          }
        },
        {
          "id": "qc~)_%y~gfB;PCRtiN[#",
          "type": "faker_store_value",
          "params": {
            "VARIABLE": "lastName",
            "TYPE": "lastName"
          }
        },
        {
          "id": "P$4vAQKB{sf87#..hxMK",
          "type": "web_fill",
          "params": {
            "SELECTOR": "[data-test=\"last-name\"]",
            "VALUE": "${lastName}"
          }
        },
        {
          "id": "rs$`HMSpF0jk?f.-,g22",
          "type": "faker_store_value",
          "params": {
            "VARIABLE": "email",
            "TYPE": "email"
          }
        },
        {
          "id": ";ZzsUf:j-!SO/KL}hKRG",
          "type": "web_fill",
          "params": {
            "SELECTOR": "[data-test=\"email\"]",
            "VALUE": "${email}"
          }
        },
        {
          "id": "4-zCBl-lIzyAMXw4]ve(",
          "type": "web_select",
          "params": {
            "SELECTOR": "[data-test=\"subject\"]",
            "VALUE": "return"
          }
        },
        {
          "id": ")Ceqxveu+[0OhvztlK?2",
          "type": "web_type",
          "params": {
            "SELECTOR": "[data-test=\"message\"]",
            "TEXT": "This is a message that should contain enough characters",
            "DELAY": 50
          }
        },
        {
          "id": "0z*gt.58K7LX`V_o__rz",
          "type": "logic_log",
          "params": {
            "LEVEL": "info",
            "MESSAGE": "Submitting contact form for: ${firstName} ${lastName} <${email}>"
          }
        },
        {
          "id": "?aVdP__q3u8OLAI$}b2o",
          "type": "web_click",
          "params": {
            "SELECTOR": "[data-test=\"contact-submit\"]"
          }
        },
        {
          "id": "KI`;zg}c8;v2h(UKApVR",
          "type": "web_wait_for_element",
          "params": {
            "SELECTOR": ".alert-success",
            "STATE": "visible"
          }
        },
        {
          "id": "e,q,(m^p`^$F$S~RYdf_",
          "type": "web_assert_text_contains",
          "params": {
            "SELECTOR": ".alert-success",
            "TEXT": "Thanks for your message! We will contact you shortly."
          }
        },
        {
          "id": "~S+Tj$nGBx/M5Xl1/JaF",
          "type": "logic_log",
          "params": {
            "LEVEL": "info",
            "MESSAGE": "Contact form submitted successfully!"
          }
        }
      ],
      "softAssertions": false
    }
  ],
  "metadata": {
    "createdAt": "2024-12-26",
    "author": "TestBlocks",
    "usesGlobals": [
      "baseUrl"
    ]
  },
  "procedures": {}
}