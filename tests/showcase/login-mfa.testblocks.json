            "TIMEOUT": 30000
          }
        },
        {
          "id": "Vt-yvD?PlCv8K:iJ|p/x",
          "type": "logic_log",
          "params": {
            "LEVEL": "info",
            "MESSAGE": "=== MFA Login Successful! ==="
          }
        }
      ],
      "softAssertions": false
    }
  ],
  "metadata": {
    "createdAt": "2026-01-11",
    "author": "TestBlocks",
    "features": [
      "mfa",
      "totp",
      "login",
      "api-cleanup",
      "procedures",
      "beforeAll",
      "afterAll"
    ],
    "usesGlobals": [
      "baseUrl",
      "apiBaseUrl",
      "credentials"
    ],
    "notes": "beforeAll: Setup MFA via web UI (login, profile, enable TOTP, sign out). test: Login with MFA. afterAll: Reset MFA via API."
  }
}