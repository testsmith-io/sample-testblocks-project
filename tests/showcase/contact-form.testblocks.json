{
  "version": "1.0.0",
  "name": "Contact Form Tests",
  "description": "Demonstrates form filling with Faker plugin for random data generation",
  "variables": {
    "firstName": {
      "type": "string",
      "default": "",
      "description": "Generated first name"
    },
    "lastName": {
      "type": "string",
      "default": "",
      "description": "Generated last name"
    },
    "email": {
      "type": "string",
      "default": "",
      "description": "Generated email address"
    },
    "message": {
      "type": "string",
      "default": "",
      "description": "Generated message content"
    }
  },
  "plugins": [
    "faker-plugin"
  ],
  "procedures": {
    "fillContactForm": {
      "name": "fillContactForm",
      "description": "Fill the contact form with provided values",
      "params": [
        {
          "name": "fname",
          "type": "string",
          "default": "",
          "description": "First name"
        },
        {
          "name": "lname",
          "type": "string",
          "default": "",
          "description": "Last name"
        },
        {
          "name": "emailAddr",
          "type": "string",
          "default": "",
          "description": "Email address"
        },
        {
          "name": "subject",
          "type": "string",
          "default": "return",
          "description": "Subject selection"
        },
        {
          "name": "msg",
          "type": "string",
          "default": "",
          "description": "Message content"
        }
      ],
      "steps": [
        {
          "id": "fill-1",
          "type": "web_fill",
          "params": {
            "SELECTOR": "[data-test=\"first-name\"]",
            "VALUE": "${fname}"
          }
        },
        {
          "id": "fill-2",
          "type": "web_fill",
          "params": {
            "SELECTOR": "[data-test=\"last-name\"]",
            "VALUE": "${lname}"
          }
        },
        {
          "id": "fill-3",
          "type": "web_fill",
          "params": {
            "SELECTOR": "[data-test=\"email\"]",
            "VALUE": "${emailAddr}"
          }
        },
        {
          "id": "fill-4",
          "type": "web_select",
          "params": {
            "SELECTOR": "[data-test=\"subject\"]",
            "VALUE": "${subject}"
          }
        },
        {
          "id": "fill-5",
          "type": "web_fill",
          "params": {
            "SELECTOR": "[data-test=\"message\"]",
            "VALUE": "${msg}"
          }
        }
      ]
    }
  },
  "tests": [
    {
      "id": "test-contact-form-submission",
      "name": "Submit Contact Form with Generated Data",
      "description": "Fill and submit the contact form using Faker-generated data",
      "tags": [
        "web",
        "form",
        "faker",
        "contact"
      ],
      "steps": [
        {
          "id": "--Q=2`W~Rug~QmUy#d[+",
          "type": "web_navigate",
          "params": {
            "URL": "${baseUrl}",
            "WAIT_UNTIL": "load"
          }
        },
        {
          "id": "1ng,fl:}t^YPe@,87TVT",
          "type": "web_click",
          "params": {
            "SELECTOR": "[data-test=\"nav-contact\"]",
            "TIMEOUT": 30000
          }
        },
        {
          "id": "]/Fv;bJx]I(M8AMU7El}",
          "type": "faker_store_value",
          "params": {
            "VARIABLE": "firstName",
            "TYPE": "firstName"
          }
        },
        {
          "id": "RuMPHojm/R@u0l|e.2SW",
          "type": "faker_store_value",
          "params": {
            "VARIABLE": "lastName",
            "TYPE": "lastName"
          }
        },
        {
          "id": "{Z)yB,(B7VMHa#P~-:sy",
          "type": "faker_store_value",
          "params": {
            "VARIABLE": "email",
            "TYPE": "email"
          }
        },
        {
          "id": "dS0#tHUP5_eP7kp!Bt*5",
          "type": "web_fill",
          "params": {
            "SELECTOR": "[data-test=\"first-name\"]",
            "VALUE": "${firstName}",
            "TIMEOUT": 30000
          }
        },
        {
          "id": "$|-)@-uf}/o-757L8?W#",
          "type": "web_fill",
          "params": {
            "SELECTOR": "[data-test=\"last-name\"]",
            "VALUE": "${lastName}",
            "TIMEOUT": 30000
          }
        },
        {
          "id": "N$8d_)$_omP+iV?Oe4X]",
          "type": "web_fill",
          "params": {
            "SELECTOR": "[data-test=\"email\"]",
            "VALUE": "${email}",
            "TIMEOUT": 30000
          }
        },
        {
          "id": "2brsM?nS1k0)s@VdfmHS",
          "type": "web_select",
          "params": {
            "SELECTOR": "[data-test=\"subject\"]",
            "VALUE": "return",
            "TIMEOUT": 30000
