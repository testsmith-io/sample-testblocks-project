        },
        {
          "id": "em#a$)3zR,dWs2x9W7-3",
          "type": "web_type",
          "params": {
            "SELECTOR": "[data-test=\"message\"]",
            "TEXT": "This is the message I like to send to the webshop.",
            "DELAY": 50,
            "TIMEOUT": 30000
          }
        },
        {
          "id": "*X|LUNPLg-U^h(~7Mh({",
          "type": "web_click",
          "params": {
            "SELECTOR": "[data-test=\"contact-submit\"]",
            "TIMEOUT": 30000
          }
        },
        {
          "id": "EX3^qElf(7{VV?sPd;Wl",
          "type": "web_assert_text_equals",
          "params": {
            "SELECTOR": ".alert-success",
            "TEXT": "Thanks for your message! We will contact you shortly.",
            "TIMEOUT": 30000
          }
        }
      ],
      "softAssertions": false
    },
