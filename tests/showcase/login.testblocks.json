{
  "version": "1.0.0",
  "name": "Login Tests",
  "description": "Demonstrates basic login functionality with valid and invalid credentials",
  "variables": {
    "loginUrl": {
      "type": "string",
      "default": "${baseUrl}/auth/login",
      "description": "Login page URL"
    }
  },
  "plugins": [
    "faker-plugin"
  ],
  "tests": [
    {
      "id": "test-valid-login",
      "name": "Valid Login - Customer",
      "description": "Login with valid customer credentials",
      "tags": [
        "login",
        "smoke",
        "positive"
      ],
      "steps": [
        {
          "id": "_7Zj(Y2X+Et_]E|Q30vb",
          "type": "web_navigate",
          "params": {
            "URL": "${baseUrl}",
            "WAIT_UNTIL": "load"
          }
        },
        {
          "id": "j~_3lt{7fgXhmX4..q/=",
          "type": "web_click",
          "params": {
            "SELECTOR": "[data-test=\"nav-sign-in\"]",
            "TIMEOUT": 30000
          }
        },
        {
          "id": "hrDFZ7077+uv:vrkV{iI",
          "type": "custom_performlogin",
          "params": {
            "EMAIL": "customer@practicesoftwaretesting.com",
            "PASSWORD": "welcome01"
          }
        },
        {
          "id": "hyVA^#iHdUar,TO[L2.N",
          "type": "web_assert_text_contains",
          "params": {
            "SELECTOR": "[data-test=\"page-title\"]",
            "TEXT": "My account",
            "TIMEOUT": 30000
          }
        },
        {
          "id": "}5EDnPnW]xw^mn?W|JQA",
          "type": "web_click",
          "params": {
            "SELECTOR": "[data-test=\"nav-user-menu\"]",
            "TIMEOUT": 30000
          }
        },
        {
          "id": "(|7Hj4aqdvSRCJ=q.Xm4",
          "type": "web_click",
          "params": {
            "SELECTOR": "[data-test=\"nav-sign-out\"]",
            "TIMEOUT": 30000
          }
        }
      ],
      "softAssertions": false
    },
    {
      "id": "test-invalid-login",
      "name": "Invalid Login - Wrong Password",
      "description": "Verify error message when using wrong password",
      "tags": [
        "login",
        "negative"
      ],
      "steps": [
        {
          "id": "ge+Vap3T5A{H-yjwBY#/",
          "type": "web_navigate",
          "params": {
            "URL": "${baseUrl}",
            "WAIT_UNTIL": "load"
          }
        },
        {
          "id": "/TRnsiu^+]u-NwuH9c?)",
          "type": "web_click",
          "params": {
            "SELECTOR": "[data-test=\"nav-sign-in\"]",
            "TIMEOUT": 30000
          }
        },
        {
          "id": "/3a2*zjjH,k2T=zBg`C`",
          "type": "custom_performlogin",
          "params": {
            "EMAIL": "customer3@practicesoftwaretesting.com",
            "PASSWORD": "x"
          }
        },
        {
          "id": "X3T5!!7qIQ+=Fnscp^n,",
          "type": "web_assert_text_contains",
          "params": {
            "SELECTOR": "[data-test=\"password-error\"]",
            "TEXT": "Password length is invalid",
            "TIMEOUT": 30000
          }
        }
      ],
      "softAssertions": false
    },
    {
      "id": "test-login-validation",
      "name": "Login Form Validation",
      "description": "Verify validation messages for blank email and password",
      "tags": [
        "login",
        "validation"
      ],
      "softAssertions": true,
      "steps": [
        {
          "id": "_(2,?@sw@KK^V4sR]-Q@",
          "type": "web_navigate",
          "params": {
            "URL": "${baseUrl}",
            "WAIT_UNTIL": "load"
          }
        },
        {
          "id": "/yf(pq/u~-MNYN$hCe4V",
          "type": "web_click",
          "params": {
            "SELECTOR": "[data-test=\"nav-sign-in\"]",
            "TIMEOUT": 30000
          }
        },
        {
          "id": "Y,hB9h$mB1Eb{LBKD~Kj",
          "type": "web_click",
          "params": {
            "SELECTOR": "[data-test=\"login-submit\"]",
            "TIMEOUT": 30000
          }
        },
        {
          "id": "~D3UT]|r?Im$iWESlhG8",
          "type": "web_assert_text_contains",
          "params": {
            "SELECTOR": "[data-test=\"email-error\"]",
            "TEXT": "E-mail is required.",
            "TIMEOUT": 30000
          }
        },
        {
          "id": "$plxno*czp0d6H7G,6mN",
          "type": "web_assert_text_contains",
          "params": {
            "SELECTOR": "[data-test=\"password-error\"]",
            "TEXT": "Password is required.",
            "TIMEOUT": 30000
          }
        }
      ]
    }
  ],
  "metadata": {
    "createdAt": "2026-01-11",
    "author": "TestBlocks",
    "features": [
      "login",
      "procedures",
      "faker",
      "soft-assertions"
    ],
    "usesGlobals": [
      "baseUrl",
      "credentials"
    ]
  },
  "afterEach": []
}